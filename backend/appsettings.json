{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Issuer": "backend-api",
    "Audience": "backend-api-clients",
    "ExpiryMinutes": 60
  },

  "Email": {
    "FromAddress": "noreply@yourapp.com",
    "FromName": "YourApp",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587
  },

  "Otp": {
    "ExpiryMinutes": 10
  },

  "Google": {
    "ClientId": "your-client-id.apps.googleusercontent.com"
  },

  "AllowedHosts": "*"
}